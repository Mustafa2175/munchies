rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify caller is an active admin or staff member in Firestore
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.isActive == true;
    }

    // Helper functions for file validation
    function isAllowedImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isWithinSizeLimit() {
      return request.resource.size <= 5 * 1024 * 1024; // 5 MB max
    }

    // Product images: public read, admin/staff upload and delete only
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isAllowedImageType() && isWithinSizeLimit();
      allow delete: if isAdmin();
    }

    // Category images: public read, admin/staff upload and delete only
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isAllowedImageType() && isWithinSizeLimit();
      allow delete: if isAdmin();
    }

    // Restaurant branding & settings images: public read, admin/staff upload and delete only
    match /settings/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isAllowedImageType() && isWithinSizeLimit();
      allow delete: if isAdmin();
    }

    // User profile uploads: authenticated owner write only
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isAllowedImageType() && isWithinSizeLimit();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default fallback: allow read for public web assets, strictly deny write to any unspecified path
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
